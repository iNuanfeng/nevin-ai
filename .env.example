# DeepSeek API 配置
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=

# 联网搜索
# ── 默认（零配置）：使用 Bing 公开搜索页，无需 API Key，国内可用
# ── 可选升级（配任一 Key 后自动优先使用）：
# 博查: https://open.bochaai.com （国内推荐）
BOCHA_API_KEY=
# Tavily: https://tavily.com
TAVILY_API_KEY=
# Serper: https://serper.dev
SERPER_API_KEY=
# Brave Search: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# 自建 SearXNG 实例（需开启 JSON 格式）: https://docs.searxng.org
# SEARXNG_URL=https://your-searxng.example.com
